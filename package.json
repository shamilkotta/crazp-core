{
  "name": "@crazp/core",
  "description": "Crazp framework implementation and build pipeline",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/shamilkotta/crazp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shamilkotta/crazp.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/shamilkotta/crazp/issues"
  },
  "keywords": [
    "crazp",
    "agents",
    "ai",
    "build-pipeline",
    "framework"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "bin": {
    "crazp": "./dist/cli/index.js"
  },
  "exports": {
    "./build": {
      "types": "./dist/build/index.d.ts",
      "import": "./dist/build/index.js"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --clear",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint ."
  },
  "dependencies": {
    "@cloudflare/sandbox": "^0.12.4",
    "@cloudflare/shell": "latest",
    "@cloudflare/think": "latest",
    "@cloudflare/worker-bundler": "^0.2.2",
    "agents": "latest",
    "ai": "^7.0.0",
    "crazp": "workspace:*",
    "ora": "^9.4.1",
    "rolldown": "^1.2.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^26.1.1",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  }
}
